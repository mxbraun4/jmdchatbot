# OpenAI API Key (erforderlich für LLM-Funktionen)
OPENAI_API_KEY=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
# OpenAI Modell (optional, Default: gpt-5-mini)
OPENAI_MODEL=gpt-5-mini

# ChromaDB Index Name (optional, Default: rag_seminararbeit)
INDEX_NAME=rag_seminararbeit

# Chunking-Parameter (optional)
CHUNK_SIZE=1024
CHUNK_OVERLAP=200

# URLs für automatische Updates (optional, als JSON-Liste)
# Beispiel: SOURCE_URLS=["https://example.com/api/laws","https://another.com/docs"]
SOURCE_URLS=[]

# Lokales Datenverzeichnis (optional, Default: data/sources)
LOCAL_DATA_DIR=data/sources

# ChromaDB Verzeichnis (optional, Default: data/chroma)
CHROMA_DB_DIR=data/chroma

# ============================================================================
# Two-Factor Authentication (2FA) Configuration
# ============================================================================

# Twilio Configuration (required for SMS 2FA)
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 2FA Settings (optional)
TWO_FA_CODE_EXPIRY_MINUTES=10
TWO_FA_SESSION_EXPIRY_MINUTES=15
TWO_FA_MAX_ATTEMPTS=3
TWO_FA_RATE_LIMIT_HOUR=5
DEFAULT_COUNTRY_CODE=+49

# For development: Set to true to log codes to console instead of sending SMS
# Set to false or remove in production
TWILIO_MOCK_MODE=true

# ============================================================================
# SMTP / Email Configuration (for Password Reset)
# ============================================================================

# SMTP Server Settings
# For Gmail: smtp.gmail.com / 587
# For Outlook: smtp.office365.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP Authentication
# For Gmail: Use your Gmail address and an "App Password" (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Email "From" Settings
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=RAG Assistant

# Password Reset Settings
PASSWORD_RESET_EXPIRY_MINUTES=60
FRONTEND_URL=https://jmdchatbot.kjf-regensburg.de
